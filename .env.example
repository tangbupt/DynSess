# DynSess environment configuration template.
# Copy to `.env` (or export in your shell) and fill in your own credentials.
# All credentials are loaded via environment variables with empty defaults —
# no keys are stored in the repo.

# ── User simulator (Doubao / Volcengine ARK) ──
# Used to drive the passive/proactive user during multi-turn dialogue generation.
ARK_API_KEY=
USER_API_BASE_URL=

# ── Assistant / role-playing model ──
# Optional; falls back to ARK_API_KEY when ASSISTANT_MODEL="api".
ASSISTANT_API_KEY=
ASSISTANT_API_BASE_URL=
# Auth mode for the assistant API: "bearer" (default, standard OpenAI-compatible)
# or "signed" (appId/appKey/projectId signed gateway — set V2_* below).
ASSISTANT_API_AUTH=bearer
# OpenAI-compatible endpoint for the role-playing model when ASSISTANT_MODEL="local".
# Point this at your vLLM / SGLang / Ollama server.
LOCAL_VLLM_URL=http://localhost:88/v1/chat/completions

# ── Judge / evaluation model ──
# Any OpenAI-compatible chat endpoint (e.g. OpenAI, Azure, a local vLLM, etc.).
EVAL_API_URL=
DYNS_EVAL_API_TOKEN=

# ── Signed-request gateway (only needed when ASSISTANT_API_AUTH=signed,
#    to route the assistant model through an appId/appKey/projectId signed
#    gateway). Most users can leave these blank. ──
V2_API_URL=
V2_API_APP_ID=
V2_API_APP_KEY=
V2_API_PROJECT_ID=
