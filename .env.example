# DynSess environment configuration template.
# Copy to `.env` (or export in your shell) and fill in your own credentials.
# DynSess never reads the Fuxi/Volcengine defaults shipped in the code at runtime
# unless you set them here — all keys are loaded via environment variables.

# ── User simulator (Doubao / Volcengine ARK) ──
# Used to drive the passive/proactive user during multi-turn dialogue generation.
ARK_API_KEY=

# ── Assistant / role-playing model ──
# Optional; falls back to ARK_API_KEY when ASSISTANT_MODEL="api".
ASSISTANT_API_KEY=
# OpenAI-compatible endpoint for the role-playing model when ASSISTANT_MODEL="local".
# Point this at your vLLM / SGLang / Ollama server.
LOCAL_VLLM_URL=http://localhost:88/v1/chat/completions

# ── Judge / evaluation model ──
# Any OpenAI-compatible chat endpoint. The paper used an internal gateway;
# point this at your own endpoint (e.g. OpenAI, Azure, a local vLLM, etc.).
EVAL_API_URL=
DYNS_EVAL_API_TOKEN=

# ── Fuxi V2 signed-request gateway (only needed if you route non-Doubao
#    assistant models through NetEase Fuxi). Most users can leave these blank. ──
V2_API_APP_ID=
V2_API_APP_KEY=
V2_API_PROJECT_ID=
